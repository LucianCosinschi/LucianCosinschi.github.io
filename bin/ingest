#!/usr/bin/env ruby
# frozen_string_literal: true
#
# bin/ingest — stamp YAML front matter onto raw Markdown dropped into _content/.
#
# Jekyll ignores collection files that have no front matter, so a document you
# copy in stays invisible until it is stamped. This script does the stamping:
#
#   * date  — from a leading YYYY-MM-DD_ filename prefix, else the file's mtime
#   * title — from the first "# H1" in the body, else the filename
#   * slug  — kebab-case, date prefix stripped
#
# It is idempotent and non-destructive: files that already begin with "---" are
# left untouched, and the body of every file is preserved byte-for-byte.
#
# Usage:  bin/ingest            (stamp everything that needs it)
#         bin/ingest --dry-run  (show what would happen, write nothing)

require "date"

Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8

ROOT    = File.expand_path("..", __dir__)
CONTENT = File.join(ROOT, "_content")
DRY     = ARGV.include?("--dry-run")

def has_front_matter?(text)
  text.start_with?("---\n") || text.start_with?("---\r\n")
end

def date_for(path)
  name = File.basename(path)
  if name =~ /\A(\d{4})-(\d{2})-(\d{2})[_-]/
    Date.new($1.to_i, $2.to_i, $3.to_i)
  else
    File.mtime(path).to_date
  end
rescue ArgumentError
  File.mtime(path).to_date
end

def title_for(path, body)
  body.each_line do |line|
    if line =~ /\A\#\s+(.+?)\s*\#*\s*\z/
      return $1.strip
    end
    # stop scanning once real prose starts (a non-blank, non-heading line)
    break if line.strip != "" && line !~ /\A\#/
  end
  titleize_filename(path)
end

def titleize_filename(path)
  base = File.basename(path, File.extname(path))
  base = base.sub(/\A\d{4}-\d{2}-\d{2}[_-]/, "")
  base.tr("_-", "  ").split(/\s+/).map { |w| w.empty? ? w : w[0].upcase + w[1..] }.join(" ")
end

def slug_for(path)
  base = File.basename(path, File.extname(path))
  base = base.sub(/\A\d{4}-\d{2}-\d{2}[_-]/, "")
  base.downcase.gsub(/[^a-z0-9]+/, "-").gsub(/\A-+|-+\z/, "")
end

def yaml_escape(str)
  %("#{str.gsub('\\', '\\\\\\\\').gsub('"', '\\"')}")
end

def section_of(path)
  rel = path.sub(CONTENT + File::SEPARATOR, "")
  rel.split(File::SEPARATOR).first || "—"
end

files = Dir.glob(File.join(CONTENT, "**", "*.md")).sort
rows  = []

files.each do |path|
  text = File.read(path)
  if has_front_matter?(text)
    rows << [section_of(path), File.basename(path), "skipped", "already stamped", ""]
    next
  end

  date  = date_for(path)
  title = title_for(path, text)
  slug  = slug_for(path)

  front = +"---\n"
  front << "title: #{yaml_escape(title)}\n"
  front << "date: #{date.strftime('%Y-%m-%d')}\n"
  front << "slug: #{slug}\n"
  front << "---\n\n"

  unless DRY
    File.write(path, front + text)
  end

  rows << [section_of(path), File.basename(path), (DRY ? "would stamp" : "stamped"),
           title, "#{date.strftime('%Y-%m-%d')}  /#{section_of(path)}/#{slug}/"]
end

# ── Summary table ────────────────────────────────────────────────
if rows.empty?
  puts "No Markdown files found under _content/."
  exit 0
end

widths = [0, 0, 0, 0]
rows.each do |r|
  4.times { |i| widths[i] = [widths[i], r[i].to_s.length].max }
end
header = %w[SECTION FILE STATUS TITLE]
4.times { |i| widths[i] = [widths[i], header[i].length].max }

fmt = "%-#{widths[0]}s  %-#{widths[1]}s  %-#{widths[2]}s  %-#{widths[3]}s  %s"
puts (DRY ? "DRY RUN — nothing written\n\n" : "")
puts format(fmt, *header, "DATE / PERMALINK")
puts "-" * (widths.sum + 12 + 16)
rows.each { |r| puts format(fmt, *r) }

stamped = rows.count { |r| r[2] =~ /stamp/ }
puts
puts "#{stamped} stamped, #{rows.length - stamped} already had front matter."
